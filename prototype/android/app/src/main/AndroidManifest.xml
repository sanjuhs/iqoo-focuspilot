<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.SET_ALARM" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <application android:label="FocusPilot · Research" android:icon="@drawable/ic_focuspilot" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:theme="@style/AppTheme" android:supportsRtl="true">
        <service android:name=".SandboxAccessibilityService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="@string/sandbox_service_label">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/sandbox_accessibility_service" />
        </service>
        <service android:name=".FocusMonitorService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started, notification-visible focus session that locally checks one user-selected app budget and provides optional distraction nudges until stopped; no microphone, location or screen capture." />
        </service>
        <service android:name=".FloatingCompanionService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Explicitly user-started, notification-visible floating visual companion with Ask Mira, Pause focus and Hide controls. Optional reviewed availability retains the same idle service while locked with no overlay or timer refresh, then restores the portrait on protected user-present while unlocked. Ask Mira opens the foreground command screen; no service microphone, screen reading, capture, model inference, boot or sticky restart." />
        </service>
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".LocalModelActivity" android:exported="false" />
        <activity android:name=".SetupActivity" android:exported="false" />
        <activity android:name=".PolicyLabActivity" android:exported="false" />
        <activity android:name=".PersonalizationActivity" android:exported="false" />
        <activity android:name=".SandboxAutomationActivity" android:exported="false" />
    </application>
</manifest>
