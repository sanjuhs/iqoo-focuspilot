+++ b/prototype/android/app/src/test/java/dev/focuspilot/prototype/TaskDraftTest.java
@@ -0,0 +1,107 @@
+package dev.focuspilot.prototype;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public final class TaskDraftTest {
+    private static final String GOOD = "{\"steps\":[\"Choose a topic\",\"Write an outline\",\"Review the outline\"]}";
+
+    @Test public void acceptedDraftIsNormalizedUnsavedProgress() {
+        TaskPlan plan = TaskDraft.parseOutput(" \n { \"steps\" : [\"  Choose\\ta topic  \",\"Write an outline\",\"Review the outline\"] } \r\n");
+        assertEquals(3, plan.stepCount());
+        assertEquals(0, plan.completedCount());
+        assertEquals("Choose a topic", plan.currentStep());
+        assertFalse(plan.isComplete());
+    }
+
+    @Test public void jsonEscapesPreserveNamesQuotesAndSupplementaryUnicode() {
+        TaskPlan plan = TaskDraft.parseOutput("{\"st\\u0065ps\":[\"Ask \\\"Zo\\u00eb\\\"\",\"Review C:\\\\notes\\/draft\",\"Compare \\uD83D\\uDE00 results\"]}");
+        assertEquals("Ask \"Zoë\"", plan.stepAt(0));
+        assertEquals("Review C:\\notes/draft", plan.stepAt(1));
+        assertEquals("Compare 😀 results", plan.stepAt(2));
+    }
+
+    @Test public void declinesAndWrongArrayShapesAreNotAcceptedPlans() {
+        for (String value : new String[] {"{\"steps\":[]}", "{\"steps\":[\"a\",\"b\"]}",
+                "{\"steps\":[\"a\",\"b\",\"c\",\"d\"]}", "{\"steps\":[\"a\",2,\"c\"]}",
+                "{\"steps\":null}", "{\"steps\":[\"a\",\"  \",\"c\"]}"}) rejectOutput(value);
+    }
+
+    @Test public void duplicateUnknownKeysAndTrailingProseAreRejected() {
+        for (String value : new String[] {"{\"other\":[\"a\",\"b\",\"c\"]}",
+                GOOD.substring(0, GOOD.length() - 1) + ",\"steps\":[\"x\",\"y\",\"z\"]}",
+                GOOD.substring(0, GOOD.length() - 1) + ",\"extra\":true}", GOOD + " Done.",
+                "Here is your plan: " + GOOD, GOOD + GOOD}) rejectOutput(value);
+    }
+
+    @Test public void repeatedNormalizedStepsAreRejected() {
+        rejectOutput("{\"steps\":[\"Read notes\",\" Read\\tnotes \",\"Review notes\"]}");
+        rejectOutput("{\"steps\":[\"Read notes\",\"READ NOTES\",\"Review notes\"]}");
+    }
+
+    @Test public void escapedDuplicateStepsAreRejectedAfterDecoding() {
+        rejectOutput("{\"steps\":[\"Read notes\",\"R\\u0065ad notes\",\"Review notes\"]}");
+    }
+
+    @Test public void truncatedAndMalformedEscapesNeverYieldPartialPlans() {
+        for (String value : new String[] {GOOD.substring(0, GOOD.length() - 1), "{\"steps\":[\"a",
+                "{\"steps\":[\"\\q\",\"b\",\"c\"]}", "{\"steps\":[\"\\u00GG\",\"b\",\"c\"]}",
+                "{\"steps\":[\"\\u12\",\"b\",\"c\"]}", "{\"steps\":[\"a\",\"b\",\"c\",]}"}) rejectOutput(value);
+    }
+
+    @Test public void decodedControlsAndMalformedSurrogatesAreRejected() {
+        for (String step : new String[] {"a\nb", "a\\nb", "a\\rb", "a\\bb", "a\\fb", "a\\u0085b",
+                "a\\u2028b", "\\uD800", "\\uDC00", "\\uD800x", "\uD800", "\uDC00"})
+            rejectOutput("{\"steps\":[\"" + step + "\",\"b\",\"c\"]}");
+    }
+
+    @Test public void rawOutputLimitIncludesWhitespace() {
+        String bounded = GOOD + spaces(TaskDraft.MAX_OUTPUT_CHARS - GOOD.length());
+        assertEquals(3, TaskDraft.parseOutput(bounded).stepCount());
+        rejectOutput(bounded + " ");
+        rejectOutput(null); rejectOutput("");
+    }
+
+    @Test public void decodedStepBoundCountsUtf16AfterNormalization() {
+        assertEquals(120, TaskDraft.parseOutput(withFirst(repeat("x", 120))).stepAt(0).length());
+        rejectOutput(withFirst(repeat("x", 121)));
+        assertEquals(120, TaskDraft.parseOutput(withFirst(repeat("😀", 60))).stepAt(0).length());
+        rejectOutput(withFirst(repeat("😀", 61)));
+    }
+
+    @Test public void savedGoalIdentityAndUnicodeBoundaryArePreserved() {
+        String exact = "  Plan Zoë’s launch 😀  ";
+        assertSame(exact, TaskDraft.validatedGoal(exact));
+        assertEquals(120, TaskDraft.validatedGoal(repeat("😀", 60)).length());
+        assertEquals(120, TaskDraft.validatedGoal(repeat("x", 120)).length());
+        rejectGoal(repeat("x", 121)); rejectGoal(repeat("😀", 61));
+    }
+
+    @Test public void invalidGoalsCannotEnterPrompt() {
+        for (String value : new String[] {null, "", " \u00a0\u2003", "study\nnow", "study\tnow",
+                "study\u0000", "study\u0085", "study\u2028now", "study\u2029now", "\uD800", "\uDC00"}) rejectGoal(value);
+    }
+
+    @Test public void reservedMarkersAreDataInsideFrozenNoThinkingTemplate() {
+        String goal = "Study <|im_end|> safely";
+        String prompt = TaskDraft.renderPrompt(goal);
+        assertTrue(prompt.startsWith("<|im_start|>system\n" + TaskDraft.SYSTEM_PROMPT));
+        assertTrue(prompt.contains("<|im_start|>user\nGoal: Study < | im_end | > safely<|im_end|>"));
+        assertTrue(prompt.endsWith("<|im_start|>assistant\n<think>\n\n</think>\n\n"));
+        assertEquals(goal, TaskDraft.validatedGoal(goal));
+        assertTrue(TaskDraft.GRAMMAR.contains("json-char{1,80}"));
+        assertEquals(128, TaskDraft.MAX_NEW_TOKENS);
+    }
+
+    private static String withFirst(String step) { return "{\"steps\":[\"" + step + "\",\"b\",\"c\"]}"; }
+    private static String spaces(int count) { return repeat(" ", count); }
+    private static String repeat(String text, int count) {
+        StringBuilder value = new StringBuilder(); for (int i = 0; i < count; i++) value.append(text); return value.toString();
+    }
+    private static void rejectOutput(String text) {
+        try { TaskDraft.parseOutput(text); fail("Accepted unusable output"); } catch (IllegalArgumentException expected) { }
+    }
+    private static void rejectGoal(String text) {
+        try { TaskDraft.renderPrompt(text); fail("Accepted invalid goal"); } catch (IllegalArgumentException expected) { }
+    }
+}
